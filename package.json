{
  "name": "x-ray",
  "version": "1.0.0",
  "description": "AI-Assisted Browser Security Extension - Phishing Detection & Data Exfiltration Prevention",
  "private": true,
  "scripts": {
    "setup": "python -m pip install -r simulation/requirements.txt && cd extension && npm install",
    "build:extension": "cd extension && npm run build",
    "dev:extension": "cd extension && npm run dev",
    "dev:server": "cd simulation && python server.py",
    "test": "pytest tests/",
    "test:unit": "pytest tests/test_unit.py",
    "test:integration": "pytest tests/test_integration.py",
    "setup:simulation": "cd simulation && pip install -r requirements.txt"
  },
  "keywords": [
    "browser-extension",
    "security",
    "phishing-detection",
    "cybersecurity",
    "chrome-extension",
    "manifest-v3"
  ],
  "license": "MIT"
}
